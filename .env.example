# --- Claude AI chat assistant ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used by the writing assistant (optional, has a sensible default)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email delivery (Resend) ---
# Get a key at https://resend.com/. If left blank, submissions are logged
# to the server console instead of emailed (handy for local development).
RESEND_API_KEY=

# Where change requests are delivered.
TO_EMAIL=ethanashergolden@gmail.com

# The "from" address. With a free Resend account you can use
# "onboarding@resend.dev". For production, verify your own domain.
FROM_EMAIL=Josh Dog Kush Portal <onboarding@resend.dev>
